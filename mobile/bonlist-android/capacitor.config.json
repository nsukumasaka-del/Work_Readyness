{
  "appId": "com.bonlist.careerbridge",
  "appName": "BonList",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "url": "https://www.bonlist.site",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0F172A",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#F3F8FC",
      "overlaysWebView": false
    }
  },
  "android": {
    "allowMixedContent": true
  }
}
