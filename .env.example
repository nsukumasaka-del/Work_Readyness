# Primary admin — recognised automatically on main site Log in
PRIMARY_ADMIN_NAME=Ntokozo Sukumasaka
PRIMARY_ADMIN_EMAIL=nsukumasaka@gmail.com
PRIMARY_ADMIN_PASSWORD=

# Encrypts MFA secrets at rest (use a long random string in production)
AUTH_ENCRYPTION_KEY=

# Email OTP / password reset (required for real signup)
# Option A — Gmail SMTP:
# 1) Google Account → Security → 2-Step Verification → App passwords
# 2) Create an app password and paste it as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nsukumasaka@gmail.com
SMTP_PASS=
SMTP_FROM="BonList <nsukumasaka@gmail.com>"

# Option B — Resend (https://resend.com) instead of SMTP:
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="BonList <onboarding@yourdomain.com>"

# NEVER leave this on in production. Only for local testing without email.
# AUTH_ALLOW_DEV_OTP=true

# ---- Cloudflare Worker gateway ----
# After deploying the static site to Cloudflare, set this Worker secret/var:
#   API_UPSTREAM_URL=https://your-node-api-host
# That host must run the BonList Express API (pnpm --filter @workspace/api-server start)
# or the all-in-one Docker image (see Dockerfile).
# API_UPSTREAM_URL=

# ---- Public URLs (required for Google OAuth + password-reset links) ----
# Browser-facing BonList web app URL (no trailing slash)
APP_BASE_URL=http://127.0.0.1:19678
# API origin as browsers reach it (often same host in production)
API_PUBLIC_URL=http://127.0.0.1:8080

# ---- Google Sign-In (OAuth 2.0 Web client) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI must be exactly:
#   {API_PUBLIC_URL}/api/career/auth/google/callback
# Authorized JavaScript origins:
#   {APP_BASE_URL}

# Passkeys / WebAuthn (defaults derived from APP_BASE_URL)
# WEBAUTHN_ENABLED=true
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://127.0.0.1:19678

# Cookies (set COOKIE_SECURE=true behind HTTPS)
# COOKIE_SECURE=true
# CORS_ORIGINS=https://your-domain.com

# Optional: Adzuna Jobs API (South Africa) for more reliable live listings.
# Free developer keys: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Database — omit or set to "pglite" for local embedded Postgres.
# DATABASE_URL=pglite

# ---- Web ↔ Android integration ----
# Required for signup/login/API from the Android APK.
# Use your deployed BonList site (the same URL that serves /api).
# Example: LIVE_APP_URL=https://your-domain.com
LIVE_APP_URL=

# Optional explicit API origin for the web build (defaults to LIVE_APP_URL when syncing Android)
# VITE_API_BASE_URL=

# Local Android live-reload (optional). Emulator default:
# CAP_LIVE_RELOAD_URL=http://10.0.2.2:19678
