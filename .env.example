# Primary admin — recognised automatically on main site Log in
PRIMARY_ADMIN_NAME=Nsuku Masaka
PRIMARY_ADMIN_EMAIL=nsukumasaka@gmail.com
PRIMARY_ADMIN_PASSWORD=

# Encrypts MFA secrets at rest (use a long random string in production)
AUTH_ENCRYPTION_KEY=

# Email — production BonList auth runs on Cloudflare Workers and uses Resend only:
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put EMAIL_FROM
# Example: EMAIL_FROM="BonList <noreply@your-verified-domain.com>"
RESEND_API_KEY=
EMAIL_FROM="BonList <onboarding@resend.dev>"

# Optional local Node API (dev only) — SMTP if you run api-server without Resend:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# NEVER leave this on in production. Only for local testing without email.
# AUTH_ALLOW_DEV_OTP=true

# ---- Cloudflare Worker ----
# Auth/email/OAuth are native on the Worker (D1 + Resend).
# Optional legacy proxy for non-auth career routes during migration:
# API_UPSTREAM_URL=

# ---- Public URLs ----
APP_BASE_URL=https://bonlist.nsukumasaka.workers.dev
API_PUBLIC_URL=https://bonlist.nsukumasaka.workers.dev

# ---- Social Sign-In (OAuth) — set as Worker secrets ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Callback URLs:
#   https://bonlist.nsukumasaka.workers.dev/api/auth/oauth/google/callback
#   https://bonlist.nsukumasaka.workers.dev/api/auth/oauth/linkedin/callback
#   https://bonlist.nsukumasaka.workers.dev/api/auth/oauth/facebook/callback
# Authorized JavaScript origins: {APP_BASE_URL}

# Passkeys / WebAuthn (defaults derived from APP_BASE_URL)
# WEBAUTHN_ENABLED=true
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://127.0.0.1:19678

# Cookies (set COOKIE_SECURE=true behind HTTPS)
# COOKIE_SECURE=true
# CORS_ORIGINS=https://your-domain.com

# Optional: Adzuna Jobs API (South Africa) for more reliable live listings.
# Free developer keys: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Database — omit or set to "pglite" for local embedded Postgres.
# DATABASE_URL=pglite

# ---- Web ↔ Android integration ----
# Required for signup/login/API from the Android APK.
# Use your deployed BonList site (the same URL that serves /api).
# Example: LIVE_APP_URL=https://your-domain.com
LIVE_APP_URL=

# Optional explicit API origin for the web build (defaults to LIVE_APP_URL when syncing Android)
# VITE_API_BASE_URL=

# Local Android live-reload (optional). Emulator default:
# CAP_LIVE_RELOAD_URL=http://10.0.2.2:19678
